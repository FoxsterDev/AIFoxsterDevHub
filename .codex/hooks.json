{
  "description": "Scoped Unity Harness routing/configuration gate. Owner trust is required through /hooks.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/harness_stop.py\"",
            "timeout": 60,
            "statusMessage": "Checking Unity Harness routing"
          }
        ]
      }
    ]
  }
}
